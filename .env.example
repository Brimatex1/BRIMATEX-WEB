# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL — accounts, sessions, addresses, wishlist and order history.
# Paste the connection string from Neon / Supabase / Railway (include
# ?sslmode=require). Leave empty to keep using the local JSONL files in
# src/data/ instead — useful for local dev without a database.
# See docs/POSTGRES_SETUP.md.
DATABASE_URL=

# Max orders per IP per minute. 0 stops all orders (maintenance).
RATE_LIMIT_ORDERS_PER_MIN=10

# Dashboard access. Comma-separated phone numbers, matched against the account's
# phone. There is no way to appoint the first admin from inside the app, so at
# least one number belongs here; those accounts can then promote others.
# Accounts listed here cannot be demoted through the UI — edit this line instead.
ADMIN_PHONES=

# Odoo Integration (leave empty for demo mode)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# WhatsApp Integration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# WhatsApp Cloud API (Meta) — delivers the one-time codes used to recover an
# account. Leave empty and the code goes to the log instead of the customer,
# which keeps the whole flow testable without a WhatsApp Business Account.
#
# The number registered here leaves the ordinary WhatsApp app permanently, so
# it must NOT be the sales line customers chat with.
#
# WHATSAPP_TOKEN must be a permanent system-user token — the one the App
# Dashboard shows by default expires after 24 hours.
# WHATSAPP_OTP_TEMPLATE must name an approved template of category
# AUTHENTICATION; Meta rejects any other category for code delivery.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=brimatex_otp
WHATSAPP_OTP_LANG=ar
