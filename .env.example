# Brimatex server configuration - copy to .env and fill in. Real environment
# variables win over this file (src/lib/load-env.js). Never commit .env.
# Every value below is optional: left empty, the server runs in local mode
# (file store, demo catalogue, codes printed to the log).

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# The site's public address, for links crawlers follow (sitemap, share pages).
# Empty: taken from each request's host.
PUBLIC_URL=

# Max orders per address per minute. 0 stops all orders (maintenance).
RATE_LIMIT_ORDERS_PER_MIN=10

# Dashboard access. Comma-separated phone numbers, matched against the account's
# phone. There is no way to appoint the first admin from inside the app, so at
# least one number belongs here; those accounts can then promote others.
# Accounts listed here cannot be demoted through the UI - edit this line instead.
ADMIN_PHONES=

# This server's own public addresses (comma-separated), if the host does not
# report them itself - they are never taken as a visitor's address for Meta.
BRIMATEX_SERVER_IPS=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL - accounts, sessions, addresses, wishlist, order history, reviews.
# Empty: the local JSONL files in src/data/. See docs/POSTGRES_SETUP.md.
DATABASE_URL=

# ── Odoo ─────────────────────────────────────────────────────────────────────
# Products, prices, stock and sales orders. Empty: the demo catalogue. Also
# editable from the dashboard (stored in src/data/settings.local.json).
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# The retail price list's id. Empty: found by name («أسعار المراتب - التجزئة»).
ODOO_PRICELIST_ID=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta) - delivers the one-time codes for opening an
# account and resetting a password. Empty: the code goes to the log instead,
# which keeps the whole flow testable without a WhatsApp Business Account.
#
# The number registered here leaves the ordinary WhatsApp app permanently, so
# it must NOT be the sales line customers chat with.
# WHATSAPP_TOKEN must be a permanent system-user token - the one the App
# Dashboard shows by default expires after 24 hours.
# WHATSAPP_OTP_TEMPLATE must name an approved template of category
# AUTHENTICATION; Meta rejects any other category for code delivery.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=brimatex_otp
WHATSAPP_OTP_LANG=ar

# The «chat with us» button. Empty: the store's support line. Also editable
# from the dashboard.
WHATSAPP_SUPPORT_PHONE=
WHATSAPP_SUPPORT_MESSAGE=

# Twilio - an optional WhatsApp invoice after each order. Empty: not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Meta (Facebook) ──────────────────────────────────────────────────────────
# Pixel / dataset ID. Usually set in the dashboard instead.
FACEBOOK_PIXEL_ID=
# Conversions API - reports each purchase to Meta from the server, where ad
# blockers and iOS limits cannot drop it. Events Manager > the dataset >
# Settings > Conversions API > "Generate access token". A secret: only in .env
# on the server, never in the repository or a chat.
FACEBOOK_CAPI_TOKEN=
# Optional, from Events Manager > Test events. While set, events go to that tab
# instead of live data - remove it after testing.
FACEBOOK_TEST_EVENT_CODE=

# ── Apple App Review ─────────────────────────────────────────────────────────
# The account given to Apple's reviewer (App Store Connect -> App Review notes).
# Created at start-up and again right after the reviewer deletes it; its
# orders stay demo orders - never Odoo, delivery, Meta or WhatsApp.
# The password is a secret: only here on the server.
BRIMATEX_REVIEW_PHONE=
BRIMATEX_REVIEW_PASSWORD=

# ── Testing only ─────────────────────────────────────────────────────────────
# 1 lets accounts open without a WhatsApp code. Never on the live server.
BRIMATEX_ALLOW_UNVERIFIED=
