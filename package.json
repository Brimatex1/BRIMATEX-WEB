{
  "name": "brimatex",
  "version": "1.0.0",
  "private": true,
  "description": "متجر بريماتكس للمراتب — واجهة React/shadcn وخادم Node",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/smoke.test.js && node tests/brand.check.js",
    "setup": "npm --prefix web install",
    "build": "npm --prefix web run build",
    "dev:api": "node server.js",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "npm --prefix web run lint",
    "migrate:pg": "node scripts/migrate-to-postgres.js"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
