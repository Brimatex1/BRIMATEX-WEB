# Dependencies
node_modules/
web/node_modules/

# src/public/ - the frontend build - is tracked on purpose, unlike most
# projects: the host cannot build the frontend at all (Rollup 4 ships a native
# part that needs GLIBC 2.29, newer than the host's), so the built files reach
# it only inside the repository. The "build" workflow builds and commits them
# (.github/workflows/deploy.yml). Do not edit them by hand.

# Product images uploaded from the dashboard - they live on the host only.
src/public/uploads/

# Runtime data the server writes (file store, settings, push and quiz state).
# src/data/demo-products.json is source data and stays tracked.
src/data/orders.local.jsonl
src/data/support.local.jsonl
src/data/users.jsonl
src/data/sessions.jsonl
src/data/otp.jsonl
src/data/devices.jsonl
src/data/product-overrides.local.json
src/data/perks.json
src/data/quiz.local.json
src/data/push.local.json
# Holds the Odoo API key.
src/data/settings.local.json

# The deploy fingerprint scripts/deploy.sh writes in the app folder on the host.
deployed.json

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code local session state
.claude/

# Logs and build info
*.log
npm-debug.log*
*.tsbuildinfo
